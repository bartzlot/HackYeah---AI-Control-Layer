# copy to .env (gitignored). Synthetic values only.
# Local dev (uv run): these paths and URLs are used as-is.
# docker compose: the gateway service overrides policy, data and upstream URLs with container values.
AICL_POLICY=policy/policy.yaml
AICL_OLLAMA_URL=http://localhost:11434
AICL_CLOUDSIM_URL=http://localhost:18200
AICL_DATA_DIR=./data
AICL_AUDIT_PATH=./data/audit.jsonl
AICL_BUDGET_DB=./data/budget.db
AICL_OLLAMA_MODEL=qwen3.5:2b-q4_K_M
# INJ-04 local cascade (make models-onnx): classifier + multilingual embedding head on CPU. The compose image sets
# AICL_MODELS_DIR=/app/models (./models mounted read-only); unset = judge-only cascade (the offline tests).
AICL_MODELS_DIR=
AICL_CLASSIFIER=1
# parallel classifier windows (default: half the cores, at most 8)
AICL_CLASSIFIER_WORKERS=
# labelled kNN examples (default: semantic/examples.yaml next to the policy file)
AICL_SEMANTIC_EXAMPLES=
# seconds the gateway waits for one upstream answer (local CPU model: long answers take minutes)
AICL_UPSTREAM_TIMEOUT_S=300
# credential the gateway injects towards the external upstream (cloud-sim accepts any)
AICL_UPSTREAM_KEY_EXTERNAL=sk-cloudsim-demo
# docker compose: host address and port of the gateway. 127.0.0.1 keeps the gateway and its console host-only;
# 0.0.0.0 publishes both, use it only when the VM firewall allows nothing but the demo IP.
AICL_GATEWAY_BIND=127.0.0.1
AICL_GATEWAY_PORT=18080
# 1 = serve /console to non-loopback clients. Keep 0 outside docker; compose sets 1 behind its host-only port.
AICL_CONSOLE_REMOTE=0
# cloud-sim (priced mock "commercial" model): listen address, and an optional YAML script of scripted replies
AICL_CLOUDSIM_HOST=127.0.0.1
AICL_CLOUDSIM_PORT=18200
AICL_CLOUDSIM_SCRIPT=
# gateway keys handed to agents (demo only)
AICL_KEY_DEMO=aicl_demo_0123456789abcdef

# ---- v4 transparent interception (python -m aicl_gateway.serve; research/14) ----
# one process, shared app: HTTP (managed gateway, console, base-URL passthrough), HTTPS, DNS
AICL_BIND=127.0.0.1
AICL_HTTP_PORT=18080
# 443 in the transparent demo (AICL CA leaf for every intercepted host); 0 = no TLS listener
AICL_TLS_PORT=0
# AICL resolver, e.g. 0.0.0.0:53 (what DHCP hands to clients); empty = no DNS listener
AICL_DNS_LISTEN=
# base directory for interception.tls.ca_cert / ca_key (the CA key never leaves it)
AICL_CA_ROOT=.
# directory that receives the root CERTIFICATE only, for clients to trust (compose: a read-only volume)
AICL_CA_PUBLISH=
# host port of the transparent demo console (docker-compose.transparent.yml), so it runs next to the base-URL compose and a local serve
AICL_TRANSPARENT_HTTP_PORT=18080
# provider upstream override, e.g. AICL_UPSTREAM_ANTHROPIC=http://mock-anthropic:18210 (offline demo)
AICL_UPSTREAM_ANTHROPIC=
AICL_UPSTREAM_OPENAI=
# NET-01: seconds after a DNS lookup of an AI host without a request through AICL before a bypass alert
AICL_NET01_WINDOW_S=30
# console is refused to these client networks even with AICL_CONSOLE_REMOTE=1 (comma-separated CIDRs)
AICL_CONSOLE_DENY_CIDRS=
# console policy / budget editor: writes need Authorization: Bearer <token>; empty = loopback clients only
AICL_ADMIN_TOKEN=
# a seed policy directory copied to the AICL_POLICY location on the first start (read-only images)
AICL_POLICY_SEED=
# signed attack-signature feed (python -m aicl_gateway.feed keygen / sign): bundle URL, pinned Ed25519 public key
AICL_FEED_URL=
AICL_FEED_PUBKEY=
AICL_FEED_INTERVAL_S=60
# local demo mode (make demo-local): host Ollama as seen from the host and from the gateway container
AICL_HOST_OLLAMA=http://127.0.0.1:11434
AICL_HOST_OLLAMA_URL=http://host.docker.internal:11434
